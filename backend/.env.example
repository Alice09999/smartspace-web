APP_NAME="SMARTSPACE AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Password awal akun uji (WAJIB diganti sebelum produksi)
ADMIN_PASSWORD=GANTI_PASSWORD_ADMIN
PENGGUNA_PASSWORD=GANTI_PASSWORD_PENGGUNA
PIMPINAN_PASSWORD=GANTI_PASSWORD_PIMPINAN

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=smartspace
DB_USERNAME=smartspace_app
DB_PASSWORD=GANTI_PASSWORD_APP

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAX_PDF_MB=5
CORS_ORIGIN=http://localhost:3000

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

SANCTUM_TOKEN_EXPIRATION=480

VITE_APP_NAME="${APP_NAME}"
